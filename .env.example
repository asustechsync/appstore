# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y completa los valores.
# .env.local vive en la raiz y lo leen todas las apps del monorepo.
# ─────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────
# IMPORTANTE: el proyecto de Postgres debe estar en sa-east-1 (Sao Paulo).
# Es la correccion de una sola linea con mayor impacto en latencia para Peru.
DATABASE_URL="postgresql://usuario:clave@host:6543/postgres?pgbouncer=true"
# Conexion directa (sin pooler) — la usan las migraciones
DIRECT_URL="postgresql://usuario:clave@host:5432/postgres"

# ── Autenticacion (Supabase Auth) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Clave publica para verificar el JWT en local, sin viaje de red.
# Esto es lo que elimina los 80-200 ms por request en rutas privadas.
SUPABASE_JWT_SECRET=""

# ── Imagenes (Cloudinary) ────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Cache y sesiones (Upstash Redis) ─────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Revalidacion del catalogo ────────────────────────────────
# Secreto que el panel envia a la web para invalidar etiquetas de cache.
REVALIDATE_SECRET=""
NEXT_PUBLIC_WEB_URL="https://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="https://localhost:3001"

# ── FASE 5 — Pasarela de pagos Izipay ────────────────────────
# Hasta que llegue F5 se usa PasarelaManual (Yape, Plin, transferencia).
# IZIPAY_USERNAME=""
# IZIPAY_PASSWORD=""
# IZIPAY_PUBLIC_KEY=""
# IZIPAY_HMAC_SHA256=""
# IZIPAY_ENDPOINT="https://api.micuentaweb.pe"

# ── FASE 6 — Facturacion electronica ─────────────────────────
# Hasta que llegue F6 se usa ComprobanteBorrador (guarda, no envia a SUNAT).
# FACTURACION_PROVEEDOR="nubefact"
# FACTURACION_TOKEN=""
# FACTURACION_ENDPOINT=""
# EMPRESA_RUC=""
# EMPRESA_RAZON_SOCIAL=""
# EMPRESA_DIRECCION_FISCAL=""
