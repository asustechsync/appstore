# Normaliza finales de línea: LF en el repo, sin importar el SO del que clona.
* text=auto eol=lf

# Binarios: git no los toca.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Lockfile: no mostrar diffs enormes en las revisiones.
package-lock.json linguist-generated=true -diff
